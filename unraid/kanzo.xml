<?xml version="1.0"?>
<!-- Unraid Docker template for Kanzo. Install: see "Unraid" in https://github.com/brabidou/kanzo-docker -->
<Container version="2">
  <Name>kanzo</Name>
  <Repository>ghcr.io/brabidou/kanzo:latest</Repository>
  <Registry>https://github.com/brabidou/kanzo-docker/pkgs/container/kanzo</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/brabidou/kanzo-docker/issues</Support>
  <Project>https://github.com/emanuele-em/kanzo</Project>
  <Overview>Kanzo: a tiny kanban board for you and your coding agents, with an MCP server built in. There are no logins: anyone who can reach the port can read and change the board, so keep it on your LAN or put an authenticating proxy in front.</Overview>
  <Category>Productivity: Tools:</Category>
  <WebUI>http://[IP]:[PORT:4242]/</WebUI>
  <Icon>https://raw.githubusercontent.com/emanuele-em/kanzo/main/src/icon.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <Config Name="Web UI port" Target="4242" Default="4242" Mode="tcp" Description="The port the board is served on." Type="Port" Display="always" Required="true" Mask="false">4242</Config>
  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/kanzo" Mode="rw" Description="The board (kanzo.db), images and config.toml." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/kanzo</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="User the board runs as; 99 is Unraid's nobody." Type="Variable" Display="advanced" Required="true" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Group the board runs as; 100 is Unraid's users." Type="Variable" Display="advanced" Required="true" Mask="false">100</Config>
</Container>
